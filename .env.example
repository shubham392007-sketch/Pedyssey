# Database
PEDYSSEY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pedyssey

# Paths
PEDYSSEY_DATA_DIR=./data
PEDYSSEY_DOCUMENTS_DIR=./data/documents
PEDYSSEY_INDEXES_DIR=./data/indexes

# Chunking
PEDYSSEY_CHUNK_TARGET_SIZE=512
PEDYSSEY_CHUNK_OVERLAP=50
PEDYSSEY_CHUNK_MIN_SIZE=100
PEDYSSEY_CHUNK_MAX_SIZE=1000

# Models
PEDYSSEY_EMBEDDING_DIMENSION=384
PEDYSSEY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PEDYSSEY_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PEDYSSEY_LLM_MODEL=llama3:8b

# System
PEDYSSEY_CONFIDENCE_THRESHOLD=0.5
